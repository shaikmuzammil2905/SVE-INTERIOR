# SV Elegant Interiors - Apache Production Configuration

# Default index file
DirectoryIndex index.html index.htm index.php

# Prevent directory listings
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Follow Symlinks safely without triggering 'Option FollowSymLinks not allowed' 403 error
<IfModule mod_core.c>
    Options -Indexes +SymLinksIfOwnerMatch
</IfModule>

# Grant public read access
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# URL Rewriting & Clean routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure /admin routes to /admin/index.html or /admin/login.html
    RewriteRule ^admin/?$ /admin/index.html [L,QSA]
    RewriteRule ^admin/login/?$ /admin/login.html [L,QSA]
</IfModule>

# Standard Error Handling (Do NOT route 403 to /index.html to avoid recursive 403 loop)
ErrorDocument 404 /index.html

# MIME Types & UTF-8 Encoding
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
